# Copy to .env (never commit .env) and fill in your OWN values.
# Load with:  set -a; source .env; set +a

# Required: create a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Required: your Telegram user ID(s), comma separated (message the bot /whoami to find it)
ALLOWED_USER_IDS=123456789

# Default prediction method for new users: "api" (ESMFold remote) or "local" (ESMFold on your GPU/CPU).
# Users can switch at any time in Telegram with /method.
FOLD_BACKEND=api
MAX_LEN_API=400
MAX_LEN_LOCAL=700

# LLM for conversational mode (plain-language messages, no slash needed), /design and the mutation explanation:
# "ollama" (local, free), "gemini" (your own AI Studio key) or "openai" (any OpenAI-compatible API).
# Without a working LLM the bot still understands simple keywords ("fold", "mutate L43D", "analyze it"...).
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Automatic fallback when Gemini hits 503 capacity limits (free key at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# How many recent messages the bot remembers per user for follow-ups like "now try it with K11R"
CHAT_HISTORY_TURNS=12

# ---- Extra prediction methods (all optional; unavailable ones show a ✗ in /method) ----
# NVIDIA-hosted ESMFold: free key from build.nvidia.com. Confirm the exact URL in the model's "API Reference" tab.
NVIDIA_API_KEY=
NVIDIA_ESMFOLD_URL=https://health.api.nvidia.com/v1/biology/nvidia/esmfold

# Local command-line tools. Install each yourself; the bot looks for them on PATH (or set the full path).
#   Boltz-2:    pip install boltz            (GPU recommended)
#   ColabFold:  install LocalColabFold       (provides colabfold_batch)
#   OmegaFold:  pip install git+https://github.com/HeliXonProtein/OmegaFold.git
BOLTZ_BIN=boltz
COLABFOLD_BIN=colabfold_batch
OMEGAFOLD_BIN=omegafold

# PRIVACY: Boltz and ColabFold build an alignment by sending your sequence to the public ColabFold server
# (api.colabfold.com). Set to 0 / single_sequence to stay fully offline (lower accuracy).
BOLTZ_USE_MSA_SERVER=1
COLABFOLD_MSA_MODE=mmseqs2_uniref_env

# Per-method max sequence length (memory dependent) and CLI timeout in seconds
MAX_LEN_NVIDIA=1000
MAX_LEN_BOLTZ=800
MAX_LEN_COLABFOLD=800
MAX_LEN_OMEGAFOLD=600
CLI_TIMEOUT=1800

# ---- Stability (ΔΔG) tools for /stability and /mutate (all optional) ----
# FoldX: free for academics but you must register and download it yourself (foldxsuite.crg.eu).
# The folder with the binary must also contain rotabase.txt (or set FOLDX_DIR).
FOLDX_BIN=foldx
FOLDX_DIR=
FOLDX_RUNS=3

# ThermoMPNN: git clone https://github.com/Kuhlman-Lab/ThermoMPNN and follow its install steps.
# Command template; {pdb} and {chain} are filled in by the bot. Use the python from ThermoMPNN's own environment.
THERMOMPNN_DIR=/path/to/ThermoMPNN
THERMOMPNN_CMD=/path/to/env/bin/python custom_inference.py --pdb {pdb} --chain {chain}
