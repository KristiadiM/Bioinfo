r"""
End-to-end bacterial WGS -> AMR gene detection pipeline
========================================================

Raw reads -> QC -> trimming -> QC -> [assembly -> AMR gene screening]
                                  \-> [mapping -> variant calling]     -> MultiQC report

Built as a portfolio project for the PhD position "Bioinformatics /
AMR-PLAS ScienceCampus" at Research Center Borstel. See README.md for
the full write-up and how each stage maps to real AMR genomics practice
(ESKAPE/mycobacteria resistance surveillance).

Run:
    snakemake -c4 --use-conda           # full run, 4 cores, per-rule conda envs
    snakemake -n                        # dry run, show the DAG of jobs
    snakemake --dag | dot -Tpng > dag.png
"""
import pandas as pd

configfile: "config/config.yaml"

SAMPLES_DF = pd.read_csv(config["samples_tsv"], sep="\t").set_index("sample", drop=False)
SAMPLES = list(SAMPLES_DF.index)
DEMO_SAMPLES = list(config.get("demo_samples", {}).keys())

wildcard_constraints:
    sample="|".join(SAMPLES) if SAMPLES else ".+"


def r1_of(sample):
    return SAMPLES_DF.loc[sample, "r1"]


def r2_of(sample):
    return SAMPLES_DF.loc[sample, "r2"]


rule all:
    input:
        "results/multiqc/multiqc_report.html",
        "results/amr/combined_amr_report.tsv",
        expand("results/variants/{sample}.filtered.vcf.gz", sample=SAMPLES),
        expand("results/assembly/{sample}/quast/report.txt", sample=SAMPLES),


# ---------------------------------------------------------------------------
# 0. Get raw reads
#    Real data: just place fastq.gz files at the paths given in
#    config/samples.tsv -- Snakemake sees they exist and this rule never
#    fires. Demo/offline mode: reads are simulated from a synthetic genome
#    so the whole pipeline can be smoke-tested with `snakemake -c4`.
# ---------------------------------------------------------------------------
rule simulate_reads:
    input:
        genome=lambda wc: config["demo_samples"][wc.sample],
    output:
        r1="data/raw/{sample}_R1.fastq.gz",
        r2="data/raw/{sample}_R2.fastq.gz",
    params:
        cov=config["simulate_reads"]["coverage"],
        rlen=config["simulate_reads"]["read_length"],
        fmean=config["simulate_reads"]["frag_mean"],
        fsd=config["simulate_reads"]["frag_sd"],
        err=config["simulate_reads"]["error_rate"],
        seed=config["simulate_reads"]["seed"],
    wildcard_constraints:
        sample="|".join(DEMO_SAMPLES) if DEMO_SAMPLES else "NEVER_MATCH",
    log:
        "logs/simulate_reads/{sample}.log",
    shell:
        """
        python3 scripts/simulate_reads.py {input.genome} {output.r1} {output.r2} \
            --coverage {params.cov} --read-length {params.rlen} \
            --frag-mean {params.fmean} --frag-sd {params.fsd} \
            --error-rate {params.err} --seed {params.seed} > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# 1. Raw read QC
# ---------------------------------------------------------------------------
rule fastqc_raw:
    input:
        r1=lambda wc: r1_of(wc.sample),
        r2=lambda wc: r2_of(wc.sample),
    output:
        "results/qc/fastqc_raw/{sample}_R1_fastqc.html",
        "results/qc/fastqc_raw/{sample}_R2_fastqc.html",
    log:
        "logs/fastqc_raw/{sample}.log",
    threads: 2
    shell:
        """
        mkdir -p results/qc/fastqc_raw
        fastqc -t {threads} -o results/qc/fastqc_raw {input.r1} {input.r2} > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# 2. Adapter / quality trimming
# ---------------------------------------------------------------------------
rule trim_reads:
    input:
        r1=lambda wc: r1_of(wc.sample),
        r2=lambda wc: r2_of(wc.sample),
    output:
        r1="results/trimmed/{sample}_R1.trim.fastq.gz",
        r2="results/trimmed/{sample}_R2.trim.fastq.gz",
        html="results/trimmed/{sample}.fastp.html",
        json="results/trimmed/{sample}.fastp.json",
    params:
        extra=config["fastp"]["extra"],
    threads: 4
    log:
        "logs/trim_reads/{sample}.log",
    shell:
        """
        fastp -i {input.r1} -I {input.r2} \
            -o {output.r1} -O {output.r2} \
            -h {output.html} -j {output.json} \
            -w {threads} {params.extra} > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# 3. Post-trim QC
# ---------------------------------------------------------------------------
rule fastqc_trimmed:
    input:
        r1="results/trimmed/{sample}_R1.trim.fastq.gz",
        r2="results/trimmed/{sample}_R2.trim.fastq.gz",
    output:
        "results/qc/fastqc_trimmed/{sample}_R1.trim_fastqc.html",
        "results/qc/fastqc_trimmed/{sample}_R2.trim_fastqc.html",
    log:
        "logs/fastqc_trimmed/{sample}.log",
    threads: 2
    shell:
        """
        mkdir -p results/qc/fastqc_trimmed
        fastqc -t {threads} -o results/qc/fastqc_trimmed {input.r1} {input.r2} > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# 4a. De novo assembly  (needed to detect horizontally-acquired resistance
#     genes that are absent from the reference genome and therefore
#     invisible to read mapping)
# ---------------------------------------------------------------------------
rule assemble_genome:
    input:
        r1="results/trimmed/{sample}_R1.trim.fastq.gz",
        r2="results/trimmed/{sample}_R2.trim.fastq.gz",
    output:
        contigs="results/assembly/{sample}/contigs.fasta",
    params:
        outdir="results/assembly/{sample}",
        extra=config["spades"]["extra"],
    threads: 4
    log:
        "logs/assemble_genome/{sample}.log",
    shell:
        """
        spades.py {params.extra} -1 {input.r1} -2 {input.r2} \
            -o {params.outdir} -t {threads} > {log} 2>&1
        """


rule quast:
    input:
        contigs="results/assembly/{sample}/contigs.fasta",
        ref=config["reference"],
    output:
        "results/assembly/{sample}/quast/report.txt",
    params:
        outdir="results/assembly/{sample}/quast",
    log:
        "logs/quast/{sample}.log",
    shell:
        """
        quast.py {input.contigs} -r {input.ref} -o {params.outdir} > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# 4b. Map trimmed reads to the reference genome and call variants
#     (needed to detect chromosomal target-mutation resistance, e.g.
#     gyrA/rpoB-type SNPs, which assembly + gene-presence screening
#     alone would not flag as clinically meaningful)
# ---------------------------------------------------------------------------
rule bwa_index:
    input:
        ref=config["reference"],
    output:
        multiext(config["reference"], ".amb", ".ann", ".bwt", ".pac", ".sa"),
    log:
        "logs/bwa_index.log",
    shell:
        "bwa index {input.ref} > {log} 2>&1"


rule align_reads:
    input:
        r1="results/trimmed/{sample}_R1.trim.fastq.gz",
        r2="results/trimmed/{sample}_R2.trim.fastq.gz",
        ref=config["reference"],
        idx=multiext(config["reference"], ".amb", ".ann", ".bwt", ".pac", ".sa"),
    output:
        bam="results/mapped/{sample}.sorted.bam",
    threads: 4
    log:
        "logs/align_reads/{sample}.log",
    shell:
        """
        (bwa mem -t {threads} -R '@RG\\tID:{wildcards.sample}\\tSM:{wildcards.sample}' \
            {input.ref} {input.r1} {input.r2} | \
            samtools sort -@ {threads} -o {output.bam} -) > {log} 2>&1
        """


rule index_bam:
    input:
        "results/mapped/{sample}.sorted.bam",
    output:
        "results/mapped/{sample}.sorted.bam.bai",
    shell:
        "samtools index {input}"


rule call_variants:
    input:
        bam="results/mapped/{sample}.sorted.bam",
        bai="results/mapped/{sample}.sorted.bam.bai",
        ref=config["reference"],
    output:
        vcf="results/variants/{sample}.vcf.gz",
    log:
        "logs/call_variants/{sample}.log",
    shell:
        """
        (bcftools mpileup -f {input.ref} {input.bam} | \
            bcftools call -mv -Oz -o {output.vcf}) > {log} 2>&1
        bcftools index -t {output.vcf}
        """


rule filter_variants:
    input:
        vcf="results/variants/{sample}.vcf.gz",
    output:
        vcf="results/variants/{sample}.filtered.vcf.gz",
    params:
        min_qual=config["variant_calling"]["min_qual"],
    log:
        "logs/filter_variants/{sample}.log",
    shell:
        """
        bcftools filter -e 'QUAL<{params.min_qual}' -Oz -o {output.vcf} {input.vcf} > {log} 2>&1
        bcftools index -t {output.vcf}
        """


# ---------------------------------------------------------------------------
# 5. AMR marker gene screening on the assembly (BLAST here; in production:
#    ABRicate / AMRFinderPlus / RGI against CARD or ResFinder)
# ---------------------------------------------------------------------------
rule makeblastdb_amr:
    input:
        db=config["amr_db"],
    output:
        multiext(config["amr_db"], ".nin", ".nhr", ".nsq"),
    log:
        "logs/makeblastdb_amr.log",
    shell:
        "makeblastdb -in {input.db} -dbtype nucl > {log} 2>&1"


rule blast_amr:
    input:
        contigs="results/assembly/{sample}/contigs.fasta",
        db=config["amr_db"],
        dbidx=multiext(config["amr_db"], ".nin", ".nhr", ".nsq"),
    output:
        "results/amr/{sample}_blast_raw.tsv",
    log:
        "logs/blast_amr/{sample}.log",
    shell:
        """
        blastn -query {input.contigs} -db {input.db} \
            -outfmt '6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore slen' \
            -out {output} > {log} 2>&1
        """


rule summarize_amr:
    input:
        blast="results/amr/{sample}_blast_raw.tsv",
        db=config["amr_db"],
    output:
        "results/amr/{sample}_amr_report.tsv",
    params:
        min_id=config["amr_screen"]["min_identity"],
        min_cov=config["amr_screen"]["min_coverage"],
    log:
        "logs/summarize_amr/{sample}.log",
    shell:
        """
        python3 scripts/filter_amr_hits.py {input.blast} {input.db} {output} \
            --sample {wildcards.sample} \
            --min-identity {params.min_id} --min-coverage {params.min_cov} > {log} 2>&1
        """


rule combine_amr_reports:
    input:
        expand("results/amr/{sample}_amr_report.tsv", sample=SAMPLES),
    output:
        "results/amr/combined_amr_report.tsv",
    run:
        import pandas as pd
        combined = pd.concat([pd.read_csv(f, sep="\t") for f in input])
        combined.to_csv(output[0], sep="\t", index=False)


# ---------------------------------------------------------------------------
# 6. Aggregate QC across all samples and stages
# ---------------------------------------------------------------------------
rule multiqc:
    input:
        expand("results/qc/fastqc_raw/{sample}_R1_fastqc.html", sample=SAMPLES),
        expand("results/qc/fastqc_trimmed/{sample}_R1.trim_fastqc.html", sample=SAMPLES),
        expand("results/trimmed/{sample}.fastp.json", sample=SAMPLES),
        expand("results/assembly/{sample}/quast/report.txt", sample=SAMPLES),
    output:
        "results/multiqc/multiqc_report.html",
    log:
        "logs/multiqc.log",
    shell:
        """
        multiqc results/qc results/trimmed results/assembly \
            -o results/multiqc -n multiqc_report.html -f > {log} 2>&1
        """
