"""
Snakemake pipeline: in-silico serial-passage resistance evolution experiment.

Mirrors a real longitudinal AMR genomic surveillance workflow: for every
simulated bacterial lineage (a condition x replicate combination), it
generates sequencing-style read counts per passage, calls the resistance
variant from those reads, aggregates the per-generation calls into an
allele-frequency trajectory with an estimated fixation time, then produces
a cross-lineage comparison plot and a summary report.

    simulate_population -> generate_reads -> call_variants
        -> aggregate_trajectory -> plot_trajectories / summarize
"""
import yaml

configfile: "config/config.yaml"

CONDITIONS = list(config["conditions"].keys())
REPLICATES = {c: list(range(config["conditions"][c]["replicates"])) for c in CONDITIONS}

def all_traj_files():
    return [
        f"results/trajectories/{c}/rep{r}.trajectory.tsv"
        for c in CONDITIONS
        for r in REPLICATES[c]
    ]

def all_fixation_files():
    return [
        f"results/trajectories/{c}/rep{r}.fixation.tsv"
        for c in CONDITIONS
        for r in REPLICATES[c]
    ]

rule all:
    input:
        "results/plots/fixation_trajectories.png",
        "results/report/summary.tsv",
        "results/report/summary.md",

rule simulate_population:
    output:
        "results/simulation/{condition}/rep{replicate}.generations.csv",
    params:
        config="config/config.yaml",
    shell:
        "python scripts/simulate_population.py "
        "--config {params.config} "
        "--condition {wildcards.condition} "
        "--replicate {wildcards.replicate} "
        "--outfile {output}"

rule generate_reads:
    input:
        "results/simulation/{condition}/rep{replicate}.generations.csv",
    output:
        "results/reads/{condition}/rep{replicate}.reads.tsv",
    params:
        config="config/config.yaml",
    shell:
        "python scripts/generate_reads.py "
        "--sim {input} --config {params.config} --outfile {output}"

rule call_variants:
    input:
        "results/reads/{condition}/rep{replicate}.reads.tsv",
    output:
        "results/calls/{condition}/rep{replicate}.calls.tsv",
    params:
        config="config/config.yaml",
    shell:
        "python scripts/call_variants.py "
        "--reads {input} --config {params.config} --outfile {output}"

rule aggregate_trajectory:
    input:
        "results/calls/{condition}/rep{replicate}.calls.tsv",
    output:
        traj="results/trajectories/{condition}/rep{replicate}.trajectory.tsv",
        fix="results/trajectories/{condition}/rep{replicate}.fixation.tsv",
    params:
        config="config/config.yaml",
    shell:
        "python scripts/aggregate_trajectory.py "
        "--calls {input} --config {params.config} "
        "--outfile {output.traj} --fixation-outfile {output.fix}"

rule plot_trajectories:
    input:
        all_traj_files(),
    output:
        "results/plots/fixation_trajectories.png",
    params:
        config="config/config.yaml",
    shell:
        "python scripts/plot_trajectories.py "
        "--trajectories {input} --config {params.config} --outfile {output}"

rule summarize:
    input:
        all_fixation_files(),
    output:
        tsv="results/report/summary.tsv",
        md="results/report/summary.md",
    shell:
        "python scripts/summarize.py "
        "--fixation-files {input} --outfile {output.tsv} --report {output.md}"
